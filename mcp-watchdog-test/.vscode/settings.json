{
  "mcpWatchdog.requireApproval": false,
  "mcpWatchdog.probeMode": "persistent",
  "mcpWatchdog.perServer": {
    "exa": {
      "enabled": false
    },
    "echo": {
      "enabled": true,
      "probeMode": "persistent"
    },
    "memory": {
      "enabled": false
    },
    "filesystem": {
      "enabled": false
    }
  },
  "mcpWatchdog.pingIntervalMs": 2000,
  "mcpWatchdog.notify": "failures",
  "mcpWatchdog.degradedAlertDelayMs": 2500
}
