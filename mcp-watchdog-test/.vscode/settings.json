{
  "mcpWatchdog.requireApproval": true,
  "mcpWatchdog.probeMode": "persistent",
  "mcpWatchdog.perServer": {
    "posthog": {
      "enabled": false
    },
    "aws-mcp": {
      "enabled": false
    },
    "exa": {
      "enabled": false
    },
    "rea": {
      "enabled": false
    },
    "apple-messages": {
      "enabled": false
    },
    "slack-eng": {
      "enabled": false
    },
    "memory": {
      "enabled": false
    },
    "filesystem": {
      "enabled": false
    },
    "filesystem-vendored": {
      "enabled": false
    },
    "filesystem-vendored-fail": {
      "enabled": false
    },
    "echo": {
      "enabled": true,
      "probeMode": "persistent"
    }
  },
  "mcpWatchdog.pingIntervalMs": 2000,
  "mcpWatchdog.notify": "failures",
  "mcpWatchdog.degradedAlertDelayMs": 2500,
  "mcpWatchdog.maxRetries": 0,
  "mcpWatchdog.cloudBridge.enabled": false,
  "mcpWatchdog.cloudBridge.url": ""
}
